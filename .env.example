# =============================================================================
# PMS — Project Management System | Public Client Environment Variables
# =============================================================================
# WARNING — SECURITY NOTICE (SECURITY.md):
# Every VITE_* variable is statically embedded into the client-side bundle and
# is publicly readable by anyone inspecting the browser or build artifacts.
# NEVER place secrets, passwords, tokens, API keys, private keys, or credentials
# in VITE_* variables. The application rejects forbidden VITE_* key patterns
# at startup (src/shared/config/env.ts).
#
# Reminder: PMS is a local frontend prototype. Client-side configuration and
# controls do not replace server-side security.
# =============================================================================

# Display name of the application
VITE_APP_NAME="PMS — Project Management System"

# Runtime environment: development | test | staging | production
VITE_APP_ENV=development

# Semantic version (SemVer)
VITE_APP_VERSION=0.1.0

# Minimum structured log level: debug | info | warn | error
VITE_LOG_LEVEL=info

# Enables local demo mode features: true | false
VITE_ENABLE_DEMO_MODE=true
